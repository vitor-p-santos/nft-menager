{
  "name": "nft-marketplace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test:e2e": "playwright test tests/e2e tests/a11y",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "test": "playwright test",
    "test:report": "playwright show-report reports/playwright",
    "lighthouse": "npm run build && node lighthouse/run.mjs",
    "check": "npm run typecheck && npm run lint && npm run build",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@hookform/resolvers": "~5.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@mswjs/socket.io-binding": "^0.2.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chrome-launcher": "^0.13.4",
    "lighthouse": "^13.5.0",
    "msw": "^2.15.0",
    "oxlint": "^1.88.0",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "engines": {
    "node": ">=22"
